# Server runtime files
logs/server.pid
logs/server.log

# Edge app-mode dedicated profile
.edge-profile/

# Runtime state files
logs/.last_archive_run

# NEVER commit — contains passwords / secrets
EMERGENCY.md
*CHEATSHEET*
*PASSWORD*
*SECRET*
*.secrets

# Runtime logs
logs/crash.txt
logs/*.txt

# Legacy wrong-path log folder
backend/logs/
